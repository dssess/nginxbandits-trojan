#!/usr/bin/env python3
"""Manage user credentials for the direct Trojan TCP/TLS listener on port 8443.

This manager intentionally does not create Nginx virtual hosts or WebSocket
backends: the project architecture is native Trojan+TLS on TCP/8443.
"""
import getpass
import json
import os
import re
import secrets
import shutil
import subprocess
import sys
from datetime import datetime
from pathlib import Path

BASE = Path("/opt/nginxbandits")
DEFAULT_CONFIG = Path("/usr/local/etc/xray/nginxbandits-trojan.json")
TLS_CERT = Path("/etc/nginxbandits/tls/fullchain.pem")
TLS_KEY = Path("/etc/nginxbandits/tls/privkey.pem")
SERVICE = "nginxbandits-trojan.service"
STATE = BASE / "core" / "trojan-accounts.json"
BACKUPS = BASE / "backups" / "trojan-accounts"
USERNAME_RE = re.compile(r"^[A-Za-z0-9_-]{3,32}$")


class ManagerError(Exception):
    pass


def run(cmd, capture=True, check=True):
    try:
        p = subprocess.run(cmd, text=True, stdout=subprocess.PIPE if capture else None,
                           stderr=subprocess.PIPE if capture else None, check=False)
    except FileNotFoundError:
        raise ManagerError(f"Required command not found: {cmd[0]}")
    if check and p.returncode:
        detail = ((p.stderr or "").strip() or (p.stdout or "").strip())
        raise ManagerError(f"Command failed ({p.returncode}): {' '.join(map(str, cmd))}"
                           + (f"\n{detail}" if detail else ""))
    return p


def require_root():
    if os.geteuid() != 0:
        raise ManagerError("Run the menu as root.")


def read_domain():
    config = BASE / "core" / "nginxbandits.conf"
    if not config.is_file():
        raise ManagerError(f"Project settings not found: {config}")
    text = config.read_text(errors="replace")
    for key in ("TROJAN_DOMAIN", "PRIMARY_DOMAIN"):
        m = re.search(rf'^\s*{key}\s*=\s*["\']?([^"\'\s#]+)', text, re.M)
        if m and m.group(1) and m.group(1) != "${PRIMARY_DOMAIN}":
            domain = m.group(1).strip()
            if "." in domain and not domain.startswith("."):
                return domain
    raise ManagerError("Set TROJAN_DOMAIN or PRIMARY_DOMAIN in nginxbandits.conf.")


def configured_port():
    config = BASE / "core" / "nginxbandits.conf"
    if config.is_file():
        match = re.search(r'^\s*TROJAN_PORT\s*=\s*["\']?(\d+)', config.read_text(errors="replace"), re.M)
        if match:
            port = int(match.group(1))
            if 1024 <= port <= 65535:
                return port
    return 8443


def config_from_service():
    p = run(["systemctl", "cat", SERVICE], check=False)
    text = (p.stdout or "") + "\n" + (p.stderr or "")
    m = re.search(r"(?:^|\s)-config\s+([^\s\\]+)", text, re.M)
    if m:
        candidate = Path(m.group(1).strip().strip('"'))
        if candidate.is_file():
            return candidate
    return None


def locate_config():
    candidates = [DEFAULT_CONFIG, Path("/usr/local/etc/xray/config.json"),
                  Path("/etc/xray/config.json"), Path("/etc/xray/nginxbandits-trojan.json")]
    service_config = config_from_service()
    if service_config:
        candidates.insert(0, service_config)
    for p in candidates:
        if p.is_file():
            try:
                data = json.loads(p.read_text())
                if any(x.get("protocol") == "trojan" and int(x.get("port", 0)) == configured_port()
                       for x in data.get("inbounds", [])):
                    return p
            except (OSError, ValueError, TypeError):
                continue
    return DEFAULT_CONFIG


def atomic_json(path, data, mode=0o640):
    path.parent.mkdir(parents=True, exist_ok=True)
    stamp = datetime.now().strftime("%Y%m%d-%H%M%S")
    if path.exists():
        BACKUPS.mkdir(parents=True, exist_ok=True)
        os.chmod(BACKUPS, 0o700)
        backup = BACKUPS / f"{path.name}.{stamp}.bak"
        shutil.copy2(path, backup)
        os.chmod(backup, 0o600)
    temp = path.with_name(path.name + f".tmp-{os.getpid()}")
    try:
        temp.write_text(json.dumps(data, indent=2) + "\n")
        os.chmod(temp, mode)
        try:
            import grp
            gid = grp.getgrnam("xray").gr_gid
            os.chown(temp, 0, gid)
        except KeyError:
            pass
        os.replace(temp, path)
    finally:
        if temp.exists():
            temp.unlink()


def bootstrap_config(path):
    """Create the expected direct-TLS config only when TLS files are available."""
    domain = read_domain()
    cert, key = TLS_CERT, TLS_KEY
    if not cert.is_file() or not key.is_file():
        le = Path("/etc/letsencrypt/live") / domain
        if (le / "fullchain.pem").is_file() and (le / "privkey.pem").is_file():
            cert, key = le / "fullchain.pem", le / "privkey.pem"
        else:
            raise ManagerError(
                "No Trojan Xray config or usable TLS certificate was found. "
                "The direct-TLS deployment must finish successfully before accounts can be added."
            )
    path.parent.mkdir(parents=True, exist_ok=True)
    config = {
        "log": {"loglevel": "warning"},
        "inbounds": [{
            "listen": "0.0.0.0", "port": configured_port(), "protocol": "trojan",
            "settings": {"clients": [], "fallbacks": []},
            "streamSettings": {
                "network": "tcp", "security": "tls",
                "tlsSettings": {"serverName": domain, "certificates": [{
                    "certificateFile": str(cert), "keyFile": str(key)
                }]}
            },
            "sniffing": {"enabled": True, "destOverride": ["http", "tls"]}
        }],
        "outbounds": [{"protocol": "freedom", "settings": {}}],
        "routing": {"domainStrategy": "AsIs", "rules": []}
    }
    atomic_json(path, config)
    return config


def load_config():
    path = locate_config()
    if not path.is_file():
        config = bootstrap_config(path)
        return path, config
    try:
        config = json.loads(path.read_text())
    except (OSError, json.JSONDecodeError) as exc:
        raise ManagerError(f"Cannot read Xray JSON config {path}: {exc}")
    inbound = direct_inbound(config)
    if inbound is None:
        raise ManagerError(
            f"{path} does not contain a native Trojan+TLS inbound on configured port {configured_port()}. "
            "Refusing to overwrite a different server configuration."
        )
    return path, config


def direct_inbound(config):
    for inbound in config.get("inbounds", []):
        stream = inbound.get("streamSettings", {})
        if (inbound.get("protocol") == "trojan" and int(inbound.get("port", 0)) == configured_port()
                and stream.get("security") == "tls"
                and stream.get("network", "tcp") == "tcp"):
            return inbound
    return None


def validate_and_apply(path, config):
    xray = shutil.which("xray") or "/usr/local/bin/xray"
    if not Path(xray).is_file():
        raise ManagerError("Xray executable not found; deploy the Trojan service first.")
    temp = path.with_name(path.name + f".validate-{os.getpid()}")
    try:
        temp.write_text(json.dumps(config, indent=2) + "\n")
        os.chmod(temp, 0o600)
        run([xray, "run", "-test", "-config", str(temp)])
    finally:
        if temp.exists():
            temp.unlink()

    old = path.read_bytes() if path.exists() else None
    old_mode = path.stat().st_mode & 0o777 if path.exists() else 0o640
    atomic_json(path, config)
    try:
        run(["systemctl", "restart", SERVICE])
        run(["systemctl", "is-active", "--quiet", SERVICE])
    except Exception as exc:
        if old is not None:
            path.write_bytes(old)
            os.chmod(path, old_mode)
        else:
            path.unlink(missing_ok=True)
        run(["systemctl", "restart", SERVICE], check=False)
        raise ManagerError(f"Account change failed; prior config restored. {exc}")


def save_state(accounts):
    STATE.parent.mkdir(parents=True, exist_ok=True)
    temp = STATE.with_name(STATE.name + f".tmp-{os.getpid()}")
    try:
        temp.write_text(json.dumps({"accounts": accounts}, indent=2) + "\n")
        os.chmod(temp, 0o600)
        os.replace(temp, STATE)
    finally:
        temp.unlink(missing_ok=True)


def state_accounts():
    if not STATE.exists():
        return {}
    try:
        data = json.loads(STATE.read_text())
        return data.get("accounts", {})
    except (OSError, json.JSONDecodeError):
        raise ManagerError(f"Account metadata file is invalid: {STATE}")


def add_account():
    require_root()
    path, config = load_config()
    inbound = direct_inbound(config)
    clients = inbound.setdefault("settings", {}).setdefault("clients", [])
    username = input("Account username (3-32 letters/numbers/_/-): ").strip()
    if not USERNAME_RE.fullmatch(username):
        raise ManagerError("Username must be 3-32 characters: letters, numbers, _ or -.")
    if any(c.get("email", "").split("@")[0] == username for c in clients):
        raise ManagerError(f"Trojan account already exists: {username}")
    password = getpass.getpass("Trojan password (blank = generate securely): ").strip()
    if not password:
        password = secrets.token_urlsafe(24)
    if len(password) < 12:
        raise ManagerError("Password must be at least 12 characters.")
    clients.append({"password": password, "email": username})
    validate_and_apply(path, config)
    accounts = state_accounts()
    accounts[username] = {"created_at": datetime.now().isoformat(timespec="seconds")}
    save_state(accounts)
    print("\nTrojan account created and Xray restarted successfully.")
    print(f"Username: {username}")
    print(f"Password: {password}")
    print(f"Server port: {configured_port()}/TCP with TLS")
    print("Save the password now; it is not stored in the menu's account list.")


def list_accounts():
    require_root()
    path, config = load_config()
    inbound = direct_inbound(config)
    clients = inbound.get("settings", {}).get("clients", [])
    if not clients:
        print("No Trojan accounts have been added yet.")
        return
    print(f"Trojan direct TLS accounts (config: {path})")
    print("-" * 44)
    for index, client in enumerate(clients, 1):
        label = client.get("email") or f"account-{index}"
        print(f"{index:>3}. {label}")


def remove_account():
    require_root()
    path, config = load_config()
    inbound = direct_inbound(config)
    clients = inbound.get("settings", {}).get("clients", [])
    if not clients:
        print("No Trojan accounts to remove.")
        return
    list_accounts()
    username = input("\nExact username to remove: ").strip()
    selected = [c for c in clients if c.get("email", "").split("@")[0] == username]
    if not selected:
        raise ManagerError(f"No Trojan account found for username: {username}")
    if input(f"Type REMOVE {username} to confirm: ").strip() != f"REMOVE {username}":
        print("Cancelled; no changes made.")
        return
    inbound["settings"]["clients"] = [
        c for c in clients if c.get("email", "").split("@")[0] != username
    ]
    validate_and_apply(path, config)
    accounts = state_accounts()
    accounts.pop(username, None)
    save_state(accounts)
    print(f"Removed Trojan account: {username}")


def show_status():
    print(f"Trojan service: {run(['systemctl', 'is-active', SERVICE], check=False).stdout.strip() or 'unknown'}")
    path = locate_config()
    print(f"Xray config: {path} ({'present' if path.is_file() else 'missing'})")
    if path.is_file():
        try:
            data = json.loads(path.read_text())
            inbound = direct_inbound(data)
            print(f"Direct Trojan TLS/8443: {'configured' if inbound else 'NOT CONFIGURED'}")
            print(f"Outbound internet (freedom): {'configured' if any(o.get('protocol') == 'freedom' for o in data.get('outbounds', [])) else 'NOT CONFIGURED'}")
            print(f"Trojan accounts: {len(inbound.get('settings', {}).get('clients', [])) if inbound else 0}")
        except (OSError, json.JSONDecodeError) as exc:
            print(f"Config read error: {exc}")


def main():
    actions = {"add": add_account, "list": list_accounts, "remove": remove_account,
               "status": show_status}
    if len(sys.argv) != 2 or sys.argv[1] not in actions:
        print("Usage: trojan-manager {add|list|status|remove}")
        return 2
    try:
        actions[sys.argv[1]]()
        return 0
    except (ManagerError, OSError, ValueError, KeyError) as exc:
        print(f"ERROR: {exc}", file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        print("\nCancelled.")
        return 130


if __name__ == "__main__":
    sys.exit(main())
